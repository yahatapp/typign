variable "aws_account_id" {
  description = "Expected AWS account ID. The AWS provider rejects credentials for another account."
  type        = string
  nullable    = false

  validation {
    condition     = can(regex("^[0-9]{12}$", var.aws_account_id))
    error_message = "aws_account_id must be a 12-digit AWS account ID."
  }
}

variable "aws_region" {
  description = "AWS Region that supports Lambda Web Functions and their Cloud Control resource handlers."
  type        = string
  default     = "ap-northeast-1"
  nullable    = false
}

variable "function_name" {
  description = "Web Function name. Changing this also replaces its endpoint and URL."
  type        = string
  default     = "typign-dev"
  nullable    = false

  validation {
    condition     = length(var.function_name) >= 2 && length(var.function_name) <= 64 && can(regex("^[A-Za-z0-9][A-Za-z0-9_-]*[A-Za-z0-9]$", var.function_name))
    error_message = "function_name must contain 2–64 letters, digits, hyphens or underscores, with an alphanumeric first and last character."
  }
}

variable "endpoint_name" {
  description = "Name of the public HomeRegion endpoint. Changing it replaces the endpoint URL."
  type        = string
  default     = "dev"
  nullable    = false

  validation {
    condition     = length(var.endpoint_name) >= 1 && length(var.endpoint_name) <= 64 && can(regex("^[A-Za-z0-9]([A-Za-z0-9_-]*[A-Za-z0-9])?$", var.endpoint_name))
    error_message = "endpoint_name must contain 1–64 letters, digits, hyphens or underscores, with an alphanumeric first and last character."
  }
}

variable "artifact_path" {
  description = "Path to the ZIP generated by pnpm package:aws, relative to this Terraform directory or absolute."
  type        = string
  default     = "../../artifacts/typign.zip"
  nullable    = false

  validation {
    condition     = fileexists(var.artifact_path) && endswith(var.artifact_path, ".zip")
    error_message = "artifact_path must point to an existing .zip file. Run pnpm package:aws before planning."
  }
}

variable "max_environments" {
  description = "Maximum execution environments for the endpoint; this limits concurrency, not total monthly cost."
  type        = number
  default     = 2
  nullable    = false

  validation {
    condition     = var.max_environments >= 2 && floor(var.max_environments) == var.max_environments
    error_message = "max_environments must be an integer of at least 2."
  }
}

variable "rate_limit" {
  description = "Endpoint requests/second. Zero closes the endpoint; supported nonzero values may vary by Region."
  type        = number
  default     = 100
  nullable    = false

  validation {
    condition     = var.rate_limit == 0 || (var.rate_limit >= 100 && var.rate_limit <= 1000 && var.rate_limit % 100 == 0) || (var.rate_limit >= 2000 && var.rate_limit <= 10000 && var.rate_limit % 1000 == 0)
    error_message = "rate_limit must be 0, 100–1000 in steps of 100, or 2000–10000 in steps of 1000."
  }
}

variable "log_retention_days" {
  description = "Retention for both centralized and local CloudWatch log groups."
  type        = number
  default     = 14
  nullable    = false

  validation {
    condition     = contains([1, 3, 5, 7, 14, 30, 60, 90, 120, 150, 180, 365, 400, 545, 731, 1096, 1827, 2192, 2557, 2922, 3288, 3653], var.log_retention_days)
    error_message = "log_retention_days must be a supported finite CloudWatch Logs retention period."
  }
}

variable "force_destroy_artifacts" {
  description = "Allow bucket deletion including every artifact version. Enable only when permanently removing this deployment."
  type        = bool
  default     = false
  nullable    = false
}

variable "tags" {
  description = "Additional resource tags. Application and ManagedBy are set by this configuration."
  type        = map(string)
  default     = {}
  nullable    = false
}
