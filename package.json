{
  "name": "typign", "version": "0.1.0", "private": true, "type": "module",
  "packageManager": "pnpm@11.11.0",
  "engines": { "node": ">=24 <25" },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build && node scripts/package.mjs",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:package": "node scripts/smoke-package.mjs",
    "package:aws": "pnpm build && node scripts/package-aws.mjs",
    "check": "pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "react": "^19.3.0", "react-dom": "^19.3.0", "hono": "^4.0.0",
    "@hono/node-server": "^1.0.0", "dexie": "^4.0.0", "zod": "^4.0.0",
    "rsc-html-stream": "^0.0.8"
  },
  "devDependencies": {
    "typescript": "^5.9.0", "@types/node": "^24.0.0", "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0", "vite": "^8.3.1", "@vitejs/plugin-react": "latest",
    "@vitejs/plugin-rsc": "latest", "vitest": "latest", "@playwright/test": "latest",
    "fake-indexeddb": "latest"
  }
}
