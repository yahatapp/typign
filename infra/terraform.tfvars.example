aws_account_id = "123456789012" # Replace with your deployment account.
aws_region     = "ap-southeast-2" # Use the Region selected for your AWS project.
function_name  = "typign-dev"
endpoint_name  = "dev"

max_environments   = 2
rate_limit         = 100
log_retention_days = 14

tags = {
  Environment = "dev"
}
